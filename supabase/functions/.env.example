# Copy to supabase/functions/.env for local runs (supabase functions serve). Never commit .env.
# For your hosted project use: supabase secrets set NAME=value

# Moonetix dashboard: Offerwalls, your offerwall, Integration
MOONETIX_APP_ID=your-app-id
MOONETIX_LINK_SALT=your-link-hash-salt
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=your-postback-secret-key

# Credit dashboard test postbacks (transaction ID starts with test_). Keep false in production.
MOONETIX_CREDIT_TEST_POSTBACKS=false
